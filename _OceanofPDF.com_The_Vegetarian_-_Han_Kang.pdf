<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">The Vegetarian: A Novel</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Winner of the 2016 Man Booker International Prize&lt;br&gt;&lt;br&gt; NAMED ONE OF THE BEST BOOKS OF THE YEAR BY&amp;#160;&lt;i&gt;The&lt;/i&gt;&amp;#160;&lt;i&gt;New York Times Book Review&amp;#160;&amp;bull; Publisher's Weekly&amp;#160;&amp;bull; &amp;#160;Buzzfeed&amp;#160;&amp;bull; &amp;#160;Entertainment Weekly&amp;#160;&amp;bull; &amp;#160;Time&amp;#160;&amp;bull; &amp;#160;Wall Street Journal&amp;#160;&amp;bull; &amp;#160;Bustle&amp;#160;&amp;bull; &amp;#160;Elle&amp;#160;&amp;bull; &amp;#160;The Economist&amp;#160;&amp;bull; &amp;#160;Slate&amp;#160;&amp;bull; &amp;#160;The Huffington Post&amp;#160;&amp;bull; The St. Louis Dispatch&amp;#160;&amp;bull; &amp;#160;Electric Literature&lt;/i&gt;&lt;br&gt;&lt;br&gt; Featured in the&amp;#160;&lt;i&gt;New York Times&lt;/i&gt;&amp;#160;selection of "15 remarkable books by women that are shaping the way we read and write fiction in the 21st century"&amp;#160;&lt;br&gt;&lt;br&gt; A beautiful, unsettling novel about rebellion and taboo, violence and eroticism, and the twisting metamorphosis of a soul&lt;br&gt; &lt;b&gt;&amp;#160;&lt;/b&gt;&lt;br&gt; Before the nightmares began, Yeong-hye and her husband lived an ordinary, controlled life. But the dreams&amp;mdash;invasive images of blood...</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Han Kang</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag/>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li>Random House Publishing Group</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:date>
        <rdf:Seq>
          <rdf:li>2016-02-02T01:00:00+01:00</rdf:li>
        </rdf:Seq>
      </dc:date>
      <dc:language>
        <rdf:Bag>
          <rdf:li>en</rdf:li>
        </rdf:Bag>
      </dc:language>
    </rdf:Description>
