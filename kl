end


initial
begin

#1000000

$display("Calibration simulation finished");

$finish;

end

endmodule


clc
clear
close all

%% AD9361 PARAMETERS

LO = 4000:100:6000;
gain = 0:76;

target_rssi = -50;

num_lo = length(LO);

best_gain = zeros(1,num_lo);
best_rssi = zeros(1,num_lo);

%% RSSI MODEL

for i = 1:num_lo
    
    lo = LO(i);
    
    for g = gain
        
        % RF response model
        rssi = -90 + g*0.65 + (lo-4000)/180 + randn*0.2;
        
        if rssi >= target_rssi
            
            best_gain(i) = g;
            best_rssi(i) = rssi;
            break
            
        end
        
    end
    
end

%% Calibration LUT

Calibration_LUT = table(LO',best_gain',best_rssi',...
    'VariableNames',{'LO_MHz','Gain_Index','RSSI_dBm'});

disp(Calibration_LUT)

%% Plot 1 Gain vs Frequency

figure
plot(LO,best_gain,'-o','LineWidth',2)
grid on
xlabel('LO Frequency (MHz)')
ylabel('Gain Index')
title('AD9361 RSSI Gain Calibration')

%% Plot 2 RSSI vs Frequency

figure
plot(LO,best_rssi,'-s','LineWidth',2)
grid on
xlabel('LO Frequency (MHz)')
ylabel('RSSI (dBm)')
title('RSSI Stability After Calibration')

