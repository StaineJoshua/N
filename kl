.reset(reset),

.rssi_value(rssi_value),
.rssi_valid(rssi_valid),

.spi_cs(spi_cs),
.spi_clk(spi_clk),
.spi_mosi(spi_mosi),

.lo_freq(lo_freq),
.gain_index(gain_index)

);


// Clock

always #5 clk = ~clk;


// Initialization

initial
begin

clk = 0;
reset = 1;

#20
reset = 0;

end


// RSSI Model

always @(posedge clk)
